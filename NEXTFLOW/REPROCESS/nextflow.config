params {
    input_csv = "*.csv"
    outdir = ""
    ref_bwa = "${baseDir}/index/BWA_MEM/hg19.fa"
    workDir = ""
    trimmomatic_options = ""
}

executor {
    name = 'local'
    queueSize = 20
    cpus = 80
    memory = 160.GB
}
profiles {
    singularity {
        singularity.enabled = true
        singularity.pullTimeout = '24h'
        singularity.autoMounts = true
    }
    slurm {
        executor {
            name = 'slurm'
            queueSize = 20
        }
        queue = 'LocalQ'
        errorStrategy = 'retry'
        maxRetries = 0
    }
    conda {
        conda.enabled = true
    }
}
process {
    errorStrategy = 'retry'
    maxRetries = 0
    resourceLimits = [cpus: 80, memory: 160.GB]
    withName: convert_fastq {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: fastqc_pre {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: multiqc_pre {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
    }
    withName: trimmomatic {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: fastqc_post {
        cpus = { 2 * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: multiqc_post {
        cpus = { 1 * task.attempt }
        memory = { 1.GB * task.attempt }
    }
    withName: bwa {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: sort_bam {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: rm_dup {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: mapped_bam {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: index {
        cpus = { 4 * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}


profiles {
    singularity {
        singularity.enabled = true
        singularity.pullTimeout = '24h'
        singularity.autoMounts = true
    }
}


report {
    overwrite = true
}
timeline {
    overwrite = true
}
trace {
    overwrite = true
}
dag {
    overwrite = true
}
