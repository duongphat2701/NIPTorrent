params {
    input_csv = "*.csv"
    outdir = ""
    reference_dir = ""
    binSize = 1000000
    gender_threshold = ""
    workdir = ""
}
workDir="${projectDir}/work"
executor {
    name = 'local'
    queueSize = 20
    cpus = 80
    memory = 200.GB
}
profiles {
    singularity {
        singularity.enabled     = true
        singularity.pullTimeout = '24h'
        singularity.autoMounts  = true
    }
    slurm {
        executor{
            name = 'slurm'
            queueSize = 20
        } 
        queue = 'LocalQ'
        errorStrategy = 'retry'
        maxRetries = 1
    }
    conda {
        conda.enabled = true
    }
}
process {
    errorStrategy = 'retry'
    maxRetries = 1
    resourceLimits = [
    cpus: 80,
    memory: 200.GB
    ]
    withName:convert_files {
        cpus   = { 4    * task.attempt }
        memory = { 8.GB * task.attempt }
    }
    withName: pca_plot {
        cpus   = { 1    * task.attempt }
        memory = { 1.GB * task.attempt }
    }
    withName: convert_gender {
        cpus   = { 1    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: seqff {
        cpus   = { 2    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: defrag_b {
        cpus   = { 1    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: read_count {
        cpus   = { 1    * task.attempt }
        memory = { 4.GB * task.attempt }
    }
    withName: wisecondorX {
        cpus   = { 4     * task.attempt }
        memory = { 8.GB * task.attempt }
    }
}   

// Get current timestamp
def timestamp = new java.text.SimpleDateFormat("yyyyMMdd_HHmmss").format(new Date())
report {
    overwrite = true
}
timeline {
    overwrite = true
}
trace {
    overwrite = true
}
dag {
    overwrite = true
}